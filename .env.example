OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Reference defaults for the planned runtime; doctor does not perform inference.
AGENT_CONTEXT_TOKENS=65536
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_MAX_INPUT_BYTES=196608
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=120
TRAVEL_MEMORY_DB=data/private/memory.sqlite3
MEMORY_CPU_THREADS=4
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_BACKEND=brave
# Process environment is read; .env files are not auto-loaded.
# Set BRAVE_API_KEY OR provide an ignored local key file:
BRAVE_API_KEY_FILE=data/private/brave-api-key
BRAVE_SEARCH_COUNTRY=KR
BRAVE_SEARCH_LANG=ko
# No automatic engine fallback. Bing comparison: provider=http, backend=bing.
# Check engine_status / engines_returned / search_complete for partial results.
# Tested webserp combination: provider=webserp, backend=yahoo.
# Google remains an explicit diagnostic path: provider=webserp, backend=google.

# Model-facing web evidence format; full structured results remain in private trace.
WEB_TOOL_FORMAT=compact_md

# Web rolling history compaction: UTF-8 bytes, not model tokens.
WEB_CONTEXT_COMPACT_BYTES=32000
WEB_CONTEXT_KEEP_TURNS=2

# Optional host-controlled MCP config. Example: examples/mcp-servers.example.json
# MCP_CONFIG_FILE=data/private/mcp-servers.json

# Bounded research found better relevant results with curl; urllib remains a comparison mode.
WEB_HTTP_TRANSPORT=curl
