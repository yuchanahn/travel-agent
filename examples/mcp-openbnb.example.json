{
  "servers": [{
    "id": "openbnb", "transport": "stdio", "enabled": true, "adapter": "openbnb",
    "command": "node",
    "args": ["/absolute/path/to/mcp-server-airbnb/dist/index.js", "--ignore-robots-txt"],
    "cwd": "/absolute/path/to/mcp-server-airbnb",
    "allowed_tools": ["airbnb_search", "airbnb_listing_details"]
  }]
}
